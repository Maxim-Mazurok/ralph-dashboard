{
  "name": "ralph-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only analytics and artifact viewer for a custom Ralph loop implementation",
  "repository": {
    "type": "git",
    "url": "https://github.com/Maxim-Mazurok/ralph-dashboard.git"
  },
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "tsx --test server/index.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "ansi-to-html": "^0.7.2",
    "express": "^5.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
